{
  "name": "al-ahmadi-real-estate",
  "private": true,
  "engines": {
    "node": "\u003e\u003d22"
  },
  "scripts": {
    "postinstall": "pnpm --filter @al-ahmadi/api db:generate",
    "dev": "pnpm --parallel --filter @al-ahmadi/api --filter @al-ahmadi/web dev",
    "dev:api": "pnpm --filter @al-ahmadi/api dev",
    "dev:web": "pnpm --filter @al-ahmadi/web dev",
    "build": "pnpm --recursive --if-present build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.2.4",
    "@prisma/client": "6.8.2",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "express-rate-limit": "^7.5.1",
    "jose": "^6.0.10",
    "prettier": "^3.5.3",
    "supertest": "^7.1.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^4.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
