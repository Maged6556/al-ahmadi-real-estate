{
  "name": "al-ahmadi-real-estate",
  "private": true,
  "engines": {
    "node": "\u003e\u003d22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @al-ahmadi/api --filter @al-ahmadi/web dev",
    "dev:api": "pnpm --filter @al-ahmadi/api dev",
    "dev:web": "pnpm --filter @al-ahmadi/web dev",
    "build": "pnpm --recursive --if-present build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@prisma/composer": "0.38.0",
    "@prisma/composer-prisma-cloud": "0.38.0",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.2.4",
    "@prisma/client": "workspace:*",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "express-rate-limit": "^7.5.1",
    "jose": "^6.0.10",
    "prettier": "^3.5.3",
    "prisma": "8.0.0-rc.33",
    "supertest": "^7.1.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^4.0.5"
  },
  "pnpm": {
    "overrides": {
      "effect": "4.0.5",
      "@effect/vitest": "4.0.5",
      "@effect/platform-bun": "4.0.5",
      "@effect/platform-node": "4.0.5",
      "@effect/platform-node-shared": "4.0.5"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
