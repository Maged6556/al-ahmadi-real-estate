{
  "name": "al-ahmadi-real-estate",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @al-ahmadi/api --filter @al-ahmadi/web dev",
    "dev:api": "pnpm --filter @al-ahmadi/api dev",
    "dev:web": "pnpm --filter @al-ahmadi/web dev",
    "build": "pnpm --recursive --if-present build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.3",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "supertest": "^7.1.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^5.0.5"
  }
}
