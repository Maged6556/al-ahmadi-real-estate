{
  "name": "al-ahmadi-real-estate",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "pnpm --filter @al-ahmadi/api db:generate",
    "dev": "pnpm --parallel --filter @al-ahmadi/api --filter @al-ahmadi/web dev",
    "dev:api": "pnpm --filter @al-ahmadi/api dev",
    "dev:web": "pnpm --filter @al-ahmadi/web dev",
    "build": "pnpm --recursive --if-present build",
    "lint": "eslint .",
    "pretest": "pnpm --filter @al-ahmadi/api db:generate",
    "test": "vitest run",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.6",
    "@prisma/client": "6.8.2",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "express-rate-limit": "^8.7.4",
    "jose": "^6.2.17",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
